# First account. The password is used only when the database has no users yet.
SWITCH_DAY0_ADMIN_USERNAME=admin
SWITCH_DAY0_ADMIN_PASSWORD=choose-a-long-password
# Signs the login cookie. The install script replaces this on first install.
SWITCH_DAY0_SECRET=your-very-long-random-secret-key-here
# Optional path to the SQLite file. Defaults to data/switch-day0.db.
# SWITCH_DAY0_DB=/opt/switch-day0/data/switch-day0.db
